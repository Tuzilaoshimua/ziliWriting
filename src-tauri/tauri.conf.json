{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "字里写作",
  "version": "0.3.2",
  "identifier": "com.zili.writing",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "title": "字里写作",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMjAwNjZBRUYyRTFCQUYKUldTdkd5N3ZhZ1lnVXg5V1g3ZnNwOWVQVzZ2TEprcnkvdFYybDhoS3Bhb1crMndHcHZEM0tQWXIK",
      "endpoints": [
        "https://gitee.com/PrincessBride/crafting-words/raw/master/latest.json"
      ]
    },
    "sql": {
      "preload": ["sqlite:zili.db"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
